# Application
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jmbattaglia?schema=public"

# ISN API Credentials
ISN_BASE_URL="https://4isn.com"
ISN_COMPANY_KEY="your_company_key"
ISN_ACCESS_KEY="your_access_key"
ISN_SECRET_ACCESS_KEY="your_secret_access_key"
ISN_OFFICE_UUID="your_office_uuid"

# Authentication (Admin JWT)
JWT_SECRET="generate-a-secure-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Optional Observe Telemetry
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
